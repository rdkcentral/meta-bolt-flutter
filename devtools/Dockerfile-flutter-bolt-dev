# Note on kernel.apparmor_restrict_unprivileged_userns:
# To guarantee you don't run into issues on affected systems, you should run this container with:
#   docker run --security-opt apparmor=unconfined ...
# Another option: disable apparmor on the host, like:
#   sudo sysctl kernel.apparmor_restrict_unprivileged_userns=0 

FROM ubuntu:22.04

# Avoid warnings/prompts by switching to noninteractive
ENV DEBIAN_FRONTEND=noninteractive
ENV USER=flutter-dev

# Install required packages 
RUN apt update \
    && apt install -y --no-install-recommends \
        build-essential \
        chrpath \
        cpio \
        debianutils \
        diffstat \
        file \
        gawk \
        gcc \
        git \
        iputils-ping \
        libacl1 \
        libcrypt-dev \
        locales \
        python3 \
        python3-git \
        python3-jinja2 \
        python3-pexpect \
        python3-pip \
        python3-subunit \
        socat \
        texinfo \
        unzip \
        wget \
        xz-utils \
        zstd \
        tmux \
        sudo \
        ca-certificates \
        vim \
        ssh \
        lz4 \
        iproute2 \
        jq \
        less \


    # Set up locales (often needed by git/python in some workflows)
    && locale-gen en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    # Install repo tool
    && wget -O /usr/local/bin/repo https://storage.googleapis.com/git-repo-downloads/repo \
    && chmod a+x /usr/local/bin/repo \
    # Create the user and set passwordless sudo
    && useradd --create-home --shell /bin/bash "$USER" \
    && echo "$USER ALL=(ALL:ALL) NOPASSWD:ALL" > "/etc/sudoers.d/$USER" \
    && chmod 0440 "/etc/sudoers.d/$USER" \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

COPY flutter_dev_entrypoint.sh /usr/local/bin/entrypoint.sh
COPY tmux_init.sh /usr/local/bin/tmux_init.sh
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/tmux_init.sh

# Keep root user briefly to allow entrypoint to map host UID/GID dynamically
# before dropping privileges to flutter-dev.
WORKDIR /home/$USER

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
